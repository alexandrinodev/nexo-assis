HOST=127.0.0.1
PORT=3333
NODE_ENV=development
# Origem confiável da interface, sem barra final. Integração Next.js será posterior.
APP_ORIGIN=http://localhost:3000

# Mesmos dados do PostgreSQL configurado no .env da raiz.
# A API roda fora do Docker: use a porta publicada no computador.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=nexo_assist
PGUSER=nexo_local
PGPASSWORD=nexo_local_dev
